# Base de données (SQLite en V1 via l'adaptateur libsql, PostgreSQL prévu ensuite)
DATABASE_URL="file:./dev.db"

# Serveur
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Stockage des photos (voir §7, §12.8). En prod : /app/storage (volume
# docker-compose) servi par le conteneur `storage` sur img.monstres.fbc.fr.
STORAGE_PATH=./storage
IMG_BASE_URL=http://localhost:3000/uploads

# Auth (JWT en cookie httpOnly)
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=access_token
JWT_COOKIE_DOMAIN=localhost
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAME_SITE=lax

# Connexion Google/Facebook (Phase 11). Sans ces 4 valeurs, les boutons
# "Continuer avec Google/Facebook" redirigent vers /connexion avec un
# message d'erreur clair — le reste de l'app fonctionne normalement.
# Google  : console.cloud.google.com → APIs & Services → Identifiants →
#           ID client OAuth 2.0 (type "Application Web").
#           URI de redirection autorisé : ${APP_URL}/api/v1/auth/google/callback
# Facebook : developers.facebook.com → Mes apps → Facebook Login → Paramètres.
#           URI de redirection OAuth valide : ${APP_URL}/api/v1/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Emails (SMTP — ex. mailcow, Postfix, etc.)
# Sans SMTP_HOST (dev local), les emails sont simplement loggés en console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@monstres.app
SMTP_FROM_NAME=Les monstres l'appli

# Notifications WhatsApp (Meta WhatsApp Cloud API — developers.facebook.com,
# app "WhatsApp Business Platform", peut réutiliser l'app créée pour la
# connexion Facebook). Sans WHATSAPP_ACCESS_TOKEN/WHATSAPP_PHONE_NUMBER_ID,
# les messages sont simplement loggés en console (dev local).
# WHATSAPP_TEMPLATE_NAME doit correspondre à un "message template" créé et
# approuvé dans Meta Business Manager, avec exactement une variable de corps
# (le texte de la notification) — Meta interdit le texte libre hors des 24h
# suivant un message du client vers l'app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=monstres_notification
WHATSAPP_TEMPLATE_LANGUAGE=fr

# Notifications push (Web Push, opt-in explicite depuis le profil). Sans ces
# clés, le bouton "Notifications push" affiche une erreur claire au lieu
# d'envoyer. Générer une paire avec : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:no-reply@monstres.fbc.fr

# Import automatique (routine Facebook → Monstres en PENDING_REVIEW).
# Sans IMPORT_API_TOKEN, l'endpoint d'import est désactivé (refus). Générer
# un token avec : node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Le compte robot IMPORT_BOT_EMAIL est créé via scripts/create-import-bot.js.
IMPORT_API_TOKEN=
IMPORT_BOT_EMAIL=import-bot@monstres.local
IMPORT_BOT_NAME=Les Monstres (import Facebook)

# Statistiques de consultation (§ KPI admin). Sans base GeoLite2 (voir
# scripts/download-geolite2.sh), la localisation des visiteurs reste vide —
# le reste des statistiques (vues, OS, navigateur, appareil) fonctionne
# normalement. ANALYTICS_HASH_SECRET sale le hachage journalier des
# visiteurs uniques (aucune IP/User-Agent brut n'est jamais stocké) ; à
# changer en production, comme JWT_SECRET.
GEOIP_DB_PATH=./data/GeoLite2-City.mmdb
ANALYTICS_HASH_SECRET=change-me-analytics-salt
